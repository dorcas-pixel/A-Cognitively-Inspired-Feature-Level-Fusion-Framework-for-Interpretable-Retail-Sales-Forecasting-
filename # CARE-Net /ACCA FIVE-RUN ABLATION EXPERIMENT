# ============================================================
# 7. CAUSAL-AWARE MODULE
# ============================================================

class CausalAwareModule(nn.Module):

    """
    Causal-aware feature transformation.

    The module separates a feature representation into:
        1. invariant / causal component
        2. residual / nuisance component

    The invariant representation is then reconstructed and
    combined with the original feature representation.

    This provides an actual trainable module rather than a
    placeholder.
    """

    def __init__(self, channels=512):

        super().__init__()

        self.causal_projection = nn.Sequential(

            nn.Conv2d(
                channels,
                channels,
                kernel_size=1,
                bias=False
            ),

            nn.BatchNorm2d(
                channels
            ),

            nn.ReLU(inplace=True)
        )

        self.residual_projection = nn.Sequential(

            nn.Conv2d(
                channels,
                channels,
                kernel_size=1,
                bias=False
            ),

            nn.BatchNorm2d(
                channels
            )
        )

        self.gate = nn.Sequential(

            nn.Conv2d(
                channels,
                channels,
                kernel_size=1
            ),

            nn.Sigmoid()
        )


    def forward(self, x):

        # Causal representation
        causal_features = self.causal_projection(x)

        # Residual / nuisance representation
        residual_features = self.residual_projection(x)

        # Difference between representations
        invariant_difference = (
            causal_features - residual_features
        )

        # Learnable causal gate
        gate = self.gate(
            invariant_difference
        )

        # Causality-aware representation
        output = (
            x +
            gate * invariant_difference
        )

        return output


# ============================================================
# 8. ANATOMY CONSTRAINT
# ============================================================

class AnatomyConstraint(nn.Module):

    """
    Anatomy-aware spatial constraint.

    The module learns a spatial anatomical relevance map
    and suppresses features outside the learned thoracic
    region.

    The spatial map is generated directly from the feature
    representation.
    """

    def __init__(self, channels=512):

        super().__init__()

        self.anatomy_map = nn.Sequential(

            nn.Conv2d(
                channels,
                channels // 4,
                kernel_size=3,
                padding=1,
                bias=False
            ),

            nn.BatchNorm2d(
                channels // 4
            ),

            nn.ReLU(inplace=True),

            nn.Conv2d(
                channels // 4,
                1,
                kernel_size=1
            ),

            nn.Sigmoid()
        )


    def forward(self, x):

        # Learn anatomical relevance
        anatomical_mask = self.anatomy_map(x)

        # Apply anatomical constraint
        constrained_features = (
            x * anatomical_mask
        )

        return constrained_features


# ============================================================
# 9. SPATIAL ATTENTION
# ============================================================

class SpatialAttention(nn.Module):

    def __init__(self):

        super().__init__()

        self.attention = nn.Sequential(

            nn.Conv2d(
                2,
                1,
                kernel_size=7,
                padding=3,
                bias=False
            ),

            nn.Sigmoid()
        )


    def forward(self, x):

        average = torch.mean(
            x,
            dim=1,
            keepdim=True
        )

        maximum, _ = torch.max(
            x,
            dim=1,
            keepdim=True
        )

        combined = torch.cat(
            [average, maximum],
            dim=1
        )

        attention_map = self.attention(
            combined
        )

        return x * attention_map


# ============================================================
# 10. CARE-NET / ACCA MODEL
# ============================================================

class CARENet(nn.Module):

    def __init__(
        self,
        use_causal=False,
        use_anatomy=False,
        use_attention=False
    ):

        super().__init__()

        self.use_causal = use_causal
        self.use_anatomy = use_anatomy
        self.use_attention = use_attention


        # ----------------------------------------------------
        # RESNET BACKBONE
        # ----------------------------------------------------

        backbone = models.resnet18(
            weights=models.ResNet18_Weights.DEFAULT
        )


        self.backbone = nn.Sequential(

            backbone.conv1,
            backbone.bn1,
            backbone.relu,
            backbone.maxpool,

            backbone.layer1,
            backbone.layer2,
            backbone.layer3,
            backbone.layer4
        )


        # ----------------------------------------------------
        # ACCA MODULES
        # ----------------------------------------------------

        if self.use_causal:

            self.causal_module = (
                CausalAwareModule(
                    channels=512
                )
            )


        if self.use_anatomy:

            self.anatomy_constraint = (
                AnatomyConstraint(
                    channels=512
                )
            )


        if self.use_attention:

            self.spatial_attention = (
                SpatialAttention()
            )


        # ----------------------------------------------------
        # CLASSIFIER
        # ----------------------------------------------------

        self.global_pool = (
            nn.AdaptiveAvgPool2d(
                (1, 1)
            )
        )

        self.dropout = nn.Dropout(
            p=0.4
        )

        self.classifier = nn.Linear(
            512,
            1
        )


    def forward(self, x):

        x = self.backbone(x)


        # ----------------------------------------------------
        # CAUSAL-AWARE COMPONENT
        # ----------------------------------------------------

        if self.use_causal:

            x = self.causal_module(x)


        # ----------------------------------------------------
        # ANATOMY CONSTRAINT
        # ----------------------------------------------------

        if self.use_anatomy:

            x = self.anatomy_constraint(x)


        # ----------------------------------------------------
        # SPATIAL ATTENTION
        # ----------------------------------------------------

        if self.use_attention:

            x = self.spatial_attention(x)


        # ----------------------------------------------------
        # CLASSIFICATION
        # ----------------------------------------------------

        x = self.global_pool(x)

        x = torch.flatten(
            x,
            start_dim=1
        )

        x = self.dropout(x)

        x = self.classifier(x)

        return x.squeeze(1)


# ============================================================
# 11. CLASS WEIGHT
# ============================================================

# Pneumonia = 1.3
# Normal = 1.0

criterion = nn.BCEWithLogitsLoss(
    pos_weight=torch.tensor(
        1.3,
        device=device
    )
)


# ============================================================
# 12. TRAINING
# ============================================================

def train_model(
    model,
    train_loader,
    val_loader,
    epochs=15
):

    optimizer = optim.AdamW(
        model.parameters(),
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY
    )


    scheduler = optim.lr_scheduler.ReduceLROnPlateau(
        optimizer,
        mode="min",
        factor=0.5,
        patience=2
    )


    best_val_loss = float("inf")

    best_state = None


    for epoch in range(epochs):

        # ====================================================
        # TRAIN
        # ====================================================

        model.train()

        total_train_loss = 0.0


        for images, labels in train_loader:

            images = images.to(
                device,
                non_blocking=True
            )

            labels = labels.float().to(
                device,
                non_blocking=True
            )


            optimizer.zero_grad()


            logits = model(
                images
            )


            loss = criterion(
                logits,
                labels
            )


            loss.backward()


            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                max_norm=5.0
            )


            optimizer.step()


            total_train_loss += (
                loss.item()
                * images.size(0)
            )


        train_loss = (
            total_train_loss /
            len(train_loader.dataset)
        )


        # ====================================================
        # VALIDATION
        # ====================================================

        model.eval()

        total_val_loss = 0.0


        with torch.no_grad():

            for images, labels in val_loader:

                images = images.to(
                    device
                )

                labels = labels.float().to(
                    device
                )


                logits = model(
                    images
                )


                loss = criterion(
                    logits,
                    labels
                )


                total_val_loss += (
                    loss.item()
                    * images.size(0)
                )


        val_loss = (
            total_val_loss /
            len(val_loader.dataset)
        )


        scheduler.step(
            val_loss
        )


        print(
            f"Epoch {epoch + 1:02d}/{epochs} | "
            f"Train Loss: {train_loss:.5f} | "
            f"Val Loss: {val_loss:.5f}"
        )


        # ====================================================
        # BEST MODEL
        # ====================================================

        if val_loss < best_val_loss:

            best_val_loss = val_loss

            best_state = copy.deepcopy(
                model.state_dict()
            )


    if best_state is not None:

        model.load_state_dict(
            best_state
        )


    return model


# ============================================================
# 13. EVALUATION
# ============================================================

def evaluate_model(
    model,
    test_loader
):

    model.eval()


    y_true = []
    y_probability = []
    y_prediction = []


    with torch.no_grad():

        for images, labels in test_loader:

            images = images.to(
                device
            )


            logits = model(
                images
            )


            probabilities = torch.sigmoid(
                logits
            )


            predictions = (
                probabilities >= 0.5
            ).long()


            y_true.extend(
                labels.numpy()
            )

            y_probability.extend(
                probabilities.cpu().numpy()
            )

            y_prediction.extend(
                predictions.cpu().numpy()
            )


    y_true = np.asarray(
        y_true
    )

    y_probability = np.asarray(
        y_probability
    )

    y_prediction = np.asarray(
        y_prediction
    )


    # ========================================================
    # ACCURACY
    # ========================================================

    accuracy = accuracy_score(
        y_true,
        y_prediction
    )


    # ========================================================
    # AUC
    # ========================================================

    auc = roc_auc_score(
        y_true,
        y_probability
    )


    # ========================================================
    # F1
    # ========================================================

    f1 = f1_score(
        y_true,
        y_prediction,
        zero_division=0
    )


    # ========================================================
    # CONFUSION MATRIX
    # ========================================================

    cm = confusion_matrix(
        y_true,
        y_prediction
    )


    return (
        accuracy,
        auc,
        f1,
        cm,
        y_true,
        y_probability,
        y_prediction
    )


